class Solution {
public:
    int findCenter(vector<vector<int>>& edges) {
        unordered_map<int, int> degree;

        for (auto &e : edges) {
            degree[e[0]]++;
            degree[e[1]]++;
        }

        int n = edges.size() + 1;

        for (auto &it : degree) {
            if (it.second == n - 1)
                return it.first;
        }

        return -1; 
    }
};
